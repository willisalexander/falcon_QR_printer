# ============================================================
# Falcon QR Printer — Agente local (El Arrecife)
# Copie este archivo como .env y complete los valores.
# El instalador (scripts\install-windows.ps1) lo crea por usted.
# ============================================================

# ── Secreto compartido con el panel ──────────────────────────
# Debe ser IDÉNTICO a AGENT_SECRET_TOKEN del panel (.env.local). Mínimo 32 caracteres.
# Generar uno:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SECRET_TOKEN=

# ── Supabase (solo metadatos; nunca se suben documentos) ─────
# Service Role Key: solo en este archivo, nunca en el navegador.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ── Carpetas locales ─────────────────────────────────────────
# Raíz del almacenamiento. Se crean dentro: Entradas, Procesando, Originales,
# PDF, Completados, Errores, Logs, Temporales, Datos y Respaldos.
BASE_DIR=C:\ElArrecife
# Carpeta donde el operador guarda las descargas de WhatsApp (por defecto BASE_DIR\Entradas)
# WATCH_DIR=C:\ElArrecife\Entradas

# ── Servicio local para el panel ─────────────────────────────
# Siempre escucha en 127.0.0.1. Si cambia el puerto, cambie también
# NEXT_PUBLIC_AGENT_URL en el panel.
AGENT_PORT=47821
# Direcciones desde las que se abre el panel, separadas por coma (sin barra final).
# Si el panel está publicado por HTTPS, agregue aquí su dominio: https://panel.midominio.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Conversión e impresión ───────────────────────────────────
# Solo si LibreOffice no está en la ruta habitual
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# sumatra = imprime de verdad | dryrun = pruebas, no envía nada a la impresora
PRINT_DRIVER=sumatra

# ── Flujo QR anterior (descarga desde Supabase Storage) ──────
# Apagado por defecto. Actívelo solo si vuelve a usar el formulario por QR.
LEGACY_QR_ENABLED=false
POLLING_INTERVAL_MS=5000
MAX_RETRIES=3
STUCK_TIMEOUT_MIN=10
TEMP_DIR=./tmp
LOG_DIR=./logs
TRAY_CARTA=
TRAY_OFICIO2=
TRAY_LEGAL=
