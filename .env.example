# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo en servidor — NUNCA exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# AGENTE LOCAL (recepción por carpeta)
# ============================================================
# Secreto compartido con el agente: debe ser IDÉNTICO al de print-agent/.env
# (mínimo 32 caracteres). Solo en servidor — NUNCA exponer al cliente.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SECRET_TOKEN=

# Dirección del agente en la misma computadora donde se abre el panel
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:47821
